# Apache 2.4, generated by Hugo from layouts/home.htaccess. Ship it with the built site.
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://open.spotify.com https://html5-player.libsyn.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pages that moved: their old addresses (front matter `aliases`).
{{- range site.Pages }}{{ $to := .RelPermalink }}{{ range .Aliases }}
  RewriteRule ^{{ partial "htaccess-pattern.html" . }}$ {{ $to }} [R=301,END]
{{- end }}{{ end }}
  # Old addresses with no page here (data/redirects.yaml).
{{- range hugo.Data.redirects }}
  RewriteRule ^{{ partial "htaccess-pattern.html" .from }}$ {{ .to }} [R=301,END]
{{- end }}
</IfModule>
{{- define "_partials/htaccess-pattern.html" -}}
{{- $p := strings.Trim . "/" | replaceRE `([.+?*()\[\]{}|^$\\])` `\$1` -}}
{{- /* Hugo stores an alias without its trailing slash: every address without a dot takes one or none */ -}}
{{- if strings.Contains . "." }}{{ $p }}{{ else }}{{ $p }}/?{{ end -}}
{{- end -}}
